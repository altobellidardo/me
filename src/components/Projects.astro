<section id="projects" class="reveal" style="animation-delay: 0.4s;">
  <div class="header">
    <h2 class="section-title">02 /<br/>Projects</h2>
    <p>A selection of recent works that push boundaries.</p>
  </div>
  
  <div class="editorial-grid">
    <article class="project-card large reveal" style="animation-delay: 0.5s;">
      <div class="number">01</div>
      <div class="content">
        <h3>Project Alpha</h3>
        <p>A high-performance web application built with modern technologies to solve complex data visualization challenges.</p>
        <a href="#" class="btn">View Case Study</a>
      </div>
    </article>
    
    <article class="project-card reveal" style="animation-delay: 0.6s;">
      <div class="number">02</div>
      <div class="content">
        <h3>Project Beta</h3>
        <p>An innovative open-source tool designed to streamline developer workflows and improve productivity.</p>
        <a href="#" class="btn">GitHub</a>
      </div>
    </article>

    <article class="project-card accent reveal" style="animation-delay: 0.7s;">
      <div class="number">03</div>
      <div class="content">
        <h3>Design System</h3>
        <p>A custom-built design system for enterprise-level applications focused on accessibility.</p>
        <a href="#" class="btn">Documentation</a>
      </div>
    </article>
  </div>
</section>

<style>
  #projects {
    margin: 8rem 0;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 4rem;
    color: var(--accent);
  }

  .header p {
    max-width: 300px;
    font-size: 1.1rem;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
    text-align: right;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-card {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 3rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 400px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    opacity: 0; /* Initial state for reveal animation */
  }

  .project-card:hover {
    transform: translateY(-10px);
    border-color: var(--accent);
  }

  .project-card.large {
    grid-column: span 2;
    min-height: 500px;
    background: linear-gradient(to bottom right, var(--bg), var(--accent-soft));
  }

  .project-card.accent {
    background: var(--accent);
    color: var(--bg);
    border: none;
  }

  .project-card.accent .number,
  .project-card.accent .btn {
    color: var(--bg);
    border-color: var(--bg);
  }

  .number {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    opacity: 0.3;
  }

  .content h3 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .content p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    opacity: 0.8;
    max-width: 400px;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    border: 1px solid var(--text);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .btn:hover {
    background: var(--text);
    color: var(--bg);
  }

  @media (max-width: 768px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .header p {
      text-align: left;
    }
    .editorial-grid {
      grid-template-columns: 1fr;
    }
    .project-card.large {
      grid-column: span 1;
    }
  }
</style>
