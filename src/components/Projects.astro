---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<section id="projects" class="reveal">
  <div class="header">
    <h2 class="section-title">04 /<br/>Projects</h2>
    <p>A selection of recent works that push boundaries.</p>
  </div>
  
  <div class="editorial-grid">
    {sortedProjects.map((project, index) => (
      <article 
        class={`project-card ${project.data.featured ? 'large' : ''} reveal`} 
        style={`transition-delay: ${0.2 + index * 0.1}s;`}
      >
        <div class="number">{String(index + 1).padStart(2, '0')}</div>
        
        {project.data.image && (
          <div class="project-image">
            <Image src={project.data.image} alt={project.data.title} width={800} height={450} format="webp" />
          </div>
        )}

        <div class="content">
          <h3 transition:name={`title-${project.id}`}>{project.data.title}</h3>
          <p>{project.data.description}</p>
          <a href={`/projects/${project.id}`} class="btn" aria-label={`View details for project: ${project.data.title}`}>View Details</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  #projects {
    margin: 8rem 0;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 4rem;
    color: var(--accent);
  }

  .header p {
    max-width: 300px;
    font-size: 1.1rem;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
    text-align: right;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-card {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 3rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 400px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, opacity 0.4s ease;
    overflow: hidden;
  }

  .project-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.2;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .project-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card:hover .project-image {
    opacity: 0.4;
    transform: scale(1.05);
  }

  .project-card:hover {
    transform: translateY(-10px);
    border-color: var(--accent);
  }

  .project-card.large {
    grid-column: span 2;
    min-height: 500px;
    background: linear-gradient(to bottom right, var(--bg), var(--accent-soft));
  }

  .number, .content {
    position: relative;
    z-index: 1;
  }

  .number {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    opacity: 0.3;
  }

  .content h3 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .content p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    opacity: 0.8;
    max-width: 400px;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    border: 1px solid var(--text);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .btn:hover {
    background: var(--text);
    color: var(--bg);
  }

  @media (max-width: 768px) {
    #projects {
      margin: 4rem 0;
    }
    .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .header p {
      text-align: left;
      font-size: 0.9rem;
    }
    .section-title {
      font-size: 2.5rem;
    }
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .project-card {
      padding: 2rem;
      min-height: 350px;
    }
    .project-card.large {
      grid-column: span 1;
      min-height: 350px;
    }
    .content h3 {
      font-size: 1.8rem;
    }
    .content p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
    .project-image {
      opacity: 0.3;
    }
    .number {
      top: 1.5rem;
      right: 1.5rem;
      font-size: 1.2rem;
    }
  }
</style>
