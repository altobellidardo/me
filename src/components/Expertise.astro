---
const skills = [
  {
    category: "Fullstack Ecosystem",
    items: ["React & Vite", "FastAPI (Python)", "Node.js", "SQL & SQLAlchemy", "Styled Components", "i18n & JWT Auth"]
  },
  {
    category: "Networking & Cloud",
    items: ["CCNA: Switching & Routing", "CCNA: Wireless Essentials", "AWS Services", "API REST Architecture", "Network Design"]
  },
  {
    category: "Engineering Roots",
    items: ["Arduino & C++", "C# Development", "Circuit Design", "Technical Documentation", "Systematic Debugging"]
  },
  {
    category: "Strategy & Agile",
    items: ["Scrum Methodology", "Information Systems Eng.", "Product Lifecycle", "Continuous Integration", "Strategic Problem Solving"]
  }
];
---

<section id="expertise" class="reveal">
  <div class="header">
    <h2 class="section-title">03 /<br/>Expertise</h2>
    <p>Technical rigor applied from low-level electronics to cloud-scale web architectures.</p>
  </div>

  <div class="expertise-grid">
    {skills.map((group) => (
      <div class="skill-group">
        <h3 class="category-title">{group.category}</h3>
        <ul class="skill-list">
          {group.items.map((item) => (
            <li class="skill-item">
              <span class="dot"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  #expertise {
    margin: 8rem 0;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 4rem;
    color: var(--accent);
  }

  .header p {
    max-width: 400px;
    font-size: 1.1rem;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
    text-align: right;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .category-title {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--text);
    letter-spacing: 0.05em;
    position: relative;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-item {
    font-size: 1rem;
    font-weight: 500;
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .skill-item:hover {
    opacity: 1;
    color: var(--accent);
    transform: translateX(5px);
  }

  .dot {
    width: 4px;
    height: 4px;
    background-color: var(--accent);
    border-radius: 50%;
  }

  @media (max-width: 768px) {
    #expertise {
      margin: 4rem 0;
    }
    .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .header p {
      text-align: left;
      font-size: 0.9rem;
    }
    .section-title {
      font-size: 2.5rem;
    }
    .expertise-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 2rem;
    }
    .category-title {
      font-size: 1.25rem;
      margin-bottom: 1.2rem;
    }
  }
</style>
