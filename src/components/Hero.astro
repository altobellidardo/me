---
---

<section id="hero" class="reveal">
  <div class="main-title">
    <div class="line">DARDO</div>
    <div class="line vertical-accent">
      <span class="text">ALTOBELLI</span>
    </div>
  </div>
  <div class="subline">
    <span class="tag">Software Architect</span>
    <span class="tag">Creative Coder</span>
    <span class="tag">Problem Solver</span>
  </div>
</section>

<style>
  #hero {
    padding: 10vh 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .main-title {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .line {
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.85;
  }

  .vertical-accent {
    position: relative;
    margin-top: 0.5rem;
    padding-left: 2rem;
    color: var(--accent);
  }

  .vertical-accent::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10%;
    bottom: 10%;
    width: 0.5rem;
    background: var(--text);
  }

  .subline {
    margin-top: 4rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 700;
    border-radius: 4px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    #hero {
      padding: 5vh 0;
    }
    .vertical-accent {
      padding-left: 1.5rem;
    }
    .vertical-accent::before {
      width: 0.3rem;
    }
  }
</style>
