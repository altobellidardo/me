---

<section id="hero" class="reveal">
  <div class="line">DARDO</div>
  <div class="line outlined">ALTOBELLI</div>
  <div class="subline">
    <span class="tag">Software Architect</span>
    <span class="tag">Creative Coder</span>
    <span class="tag">Problem Solver</span>
  </div>
</section>

<style>
  #hero {
    padding: 10vh 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .line {
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .outlined {
    -webkit-text-stroke: 1px var(--text);
    color: transparent;
  }

  .subline {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 700;
    border-radius: 4px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    #hero {
      padding: 5vh 0;
    }
  }
</style>
