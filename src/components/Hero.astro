---
---

<section id="hero" class="reveal">
  <div class="main-title">
    <div class="line first-name">
      <span class="solid">DARDO</span>
      <span class="outline">DARDO</span>
    </div>
    <div class="line last-name">
      <span class="accent">ALTOBELLI</span>
      <span class="accent-outline">ALTOBELLI</span>
    </div>
  </div>
  <div class="subline">
    <span class="tag">Software Architect</span>
    <span class="tag">Creative Coder</span>
    <span class="tag">Problem Solver</span>
  </div>
</section>

<style>
  #hero {
    padding: 15vh 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    overflow: visible;
  }

  .main-title {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .line {
    font-size: clamp(5rem, 18vw, 15rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.75;
    position: relative;
    text-transform: uppercase;
  }

  .first-name {
    z-index: 2;
  }

  .last-name {
    margin-top: -0.1em; /* Heavy overlap */
    z-index: 1;
    padding-left: 0.1em;
  }

  .solid {
    color: var(--text);
  }

  .outline {
    position: absolute;
    top: 0.05em;
    left: 0.05em;
    -webkit-text-stroke: 1px var(--accent);
    color: transparent;
    z-index: -1;
    opacity: 0.5;
  }

  .accent {
    color: var(--accent);
  }

  .accent-outline {
    position: absolute;
    top: 0.05em;
    left: 0.05em;
    -webkit-text-stroke: 1px var(--text);
    color: transparent;
    z-index: -1;
    opacity: 0.3;
  }

  .subline {
    margin-top: 5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    z-index: 3;
  }

  .tag {
    background: var(--bg);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.5rem 1.2rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 700;
    border-radius: 2px;
    letter-spacing: 0.15em;
    transition: all 0.3s ease;
  }

  .tag:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (max-width: 768px) {
    #hero {
      padding: 10vh 0;
    }
    .line {
      line-height: 0.8;
    }
    .last-name {
      padding-left: 0;
      margin-top: 0;
    }
    .subline {
      margin-top: 3rem;
    }
  }
</style>
