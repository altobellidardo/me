---
---

<section id="contact" class="reveal">
  <div class="editorial-grid">
    <div class="title-wrap">
      <h2 class="section-title">05 /<br/>Contact</h2>
    </div>
    
    <div class="content">
      <p class="cta">Let's build something that <span class="accent-text">matters</span>.</p>
      
      <div class="links">
        <a href="https://github.com/dardoaltobelli" target="_blank" class="big-link">
          <span class="label">01 /</span> 
          <span class="link-text">GitHub</span>
          <span class="hover-text">Source Control</span>
        </a>
        <a href="https://linkedin.com/in/dardoaltobelli" target="_blank" class="big-link">
          <span class="label">02 /</span> 
          <span class="link-text">LinkedIn</span>
          <span class="hover-text">Professional Network</span>
        </a>
        <div class="email-wrapper">
          <button id="copy-email" class="big-link email-btn" data-email="contact@dardoaltobelli.com">
            <span class="label">03 /</span> 
            <span class="link-text">Email</span>
            <span id="copy-feedback" class="hover-text">Copy to Clipboard</span>
          </button>
        </div>
      </div>

      <div class="footer-note">
        <p>© {new Date().getFullYear()} Dardo Altobelli. Built with Astro & Passion.</p>
      </div>
    </div>
  </div>
</section>

<script>
  function setupEmailCopy() {
    const copyBtn = document.getElementById('copy-email');
    const feedback = document.getElementById('copy-feedback');
    
    if (copyBtn && feedback) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (email) {
          try {
            await navigator.clipboard.writeText(email);
            const originalText = feedback.innerText;
            feedback.innerText = "Email Copied!";
            feedback.style.color = "var(--text)";
            
            setTimeout(() => {
              feedback.innerText = originalText;
              feedback.style.color = "";
            }, 2000);
          } catch (err) {
            console.error('Failed to copy: ', err);
          }
        }
      });
    }
  }

  // Init
  setupEmailCopy();
  // View Transitions support
  document.addEventListener('astro:after-swap', setupEmailCopy);
</script>

<style>
  #contact {
    margin: 15rem 0 10vh 0;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .section-title {
    font-size: 4rem;
    color: var(--accent);
  }

  .accent-text {
    color: var(--accent);
    font-style: italic;
  }

  .cta {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-top: 0;
    margin-bottom: 5rem;
    max-width: 600px;
  }

  .links {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .big-link {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: transparent;
    border-left: none;
    border-right: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    color: var(--text);
  }

  .big-link:hover {
    padding-left: 2rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .label {
    font-size: 1rem;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.1em;
    font-family: var(--font-body);
  }

  .hover-text {
    font-size: 1rem;
    font-weight: 500;
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.4s ease;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    pointer-events: none;
  }

  .big-link:hover .hover-text {
    opacity: 0.5;
    transform: translateX(0);
  }

  .email-wrapper {
    width: 100%;
  }

  .footer-note {
    margin-top: 8rem;
    opacity: 0.4;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .section-title {
      font-size: 3rem;
    }
    .big-link {
      font-size: 2.5rem;
      gap: 1rem;
    }
    .hover-text {
      display: none;
    }
  }
</style>
