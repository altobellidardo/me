---

<section id="contact" class="reveal" style="animation-delay: 0.6s;">
  <div class="editorial-grid">
    <h2 class="section-title">03 /<br/>Contact</h2>
    <div class="content">
      <p class="cta">Ready to build something legendary?</p>
      
      <div class="links">
        <a href="https://github.com/dardoaltobelli" target="_blank" class="big-link">
          <span class="label">GH /</span> GitHub
        </a>
        <a href="https://linkedin.com/in/dardoaltobelli" target="_blank" class="big-link">
          <span class="label">LI /</span> LinkedIn
        </a>
        <a href="mailto:contact@dardoaltobelli.com" class="big-link">
          <span class="label">EM /</span> Email
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #contact {
    margin: 8rem 0 15vh 0;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .section-title {
    font-size: 4rem;
    color: var(--accent);
  }

  .cta {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 3rem;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .big-link {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 5rem);
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.3s ease;
  }

  .big-link:hover {
    transform: translateX(20px);
  }

  .label {
    font-size: 1rem;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .section-title {
      font-size: 3rem;
    }
  }
</style>
