---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: System Error | Dardo Altobelli" description="The requested path does not exist in the current architecture.">
  <main class="error-page">
    <section class="animate-mount">
      <div class="error-code">404</div>
      <h1 class="error-title">PATH_NOT_FOUND</h1>
      <p class="error-message">
        The requested resource has been moved, removed, or never existed in this architecture. 
        Please return to the main entry point.
      </p>
      <div class="actions">
        <a href="/" class="back-btn">← Return Home</a>
      </div>
    </section>

    <div class="decoration animate-mount" style="transition-delay: 0.2s;">
      <div class="line">SYSTEM_HALT</div>
      <div class="line outlined">SEGMENTATION_FAULT</div>
      <div class="line">REBOOT_REQUIRED</div>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 5vw;
    position: relative;
    overflow: hidden;
  }

  .error-code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 15rem);
    font-weight: 900;
    color: var(--accent);
    line-height: 0.8;
    margin-bottom: 2rem;
  }

  .error-title {
    font-size: 2rem;
    letter-spacing: 0.2em;
    margin-bottom: 2rem;
    opacity: 0.8;
  }

  .error-message {
    max-width: 500px;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 auto 4rem auto;
    opacity: 0.6;
  }

  .back-btn {
    display: inline-block;
    padding: 1rem 3rem;
    border: 2px solid var(--accent);
    color: var(--accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: all 0.3s ease;
  }

  .back-btn:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .decoration {
    position: absolute;
    bottom: 5vh;
    width: 100%;
    display: flex;
    justify-content: space-around;
    opacity: 0.05;
    pointer-events: none;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3rem;
  }

  .outlined {
    -webkit-text-stroke: 1px var(--text);
    color: transparent;
  }

  @media (max-width: 768px) {
    .decoration {
      flex-direction: column;
      font-size: 1.5rem;
      gap: 1rem;
    }
  }
</style>
