---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sortedProjects = projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  
  return sortedProjects.map((entry, index) => {
    const nextEntry = sortedProjects[index + 1] || sortedProjects[0]; // Loop back to start
    return {
      params: { slug: entry.id }, 
      props: { entry, nextEntry },
    }
  });
}

const { entry, nextEntry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Dardo Altobelli`} description={entry.data.description}>
  <main id="main-content" class="project-page">
    <header class="project-header reveal">
      <div class="header-container">
        <a href="/" class="back-link" aria-label="Back to home">
          <span class="arrow">←</span> Home
        </a>
        
        <h1 class="project-title" transition:name={`title-${entry.id}`}>
          {entry.data.title}
        </h1>
        
        <div class="project-meta">
          <div class="meta-item">
            <span class="label">Date /</span>
            <span class="value">{entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</span>
          </div>
          <div class="meta-item">
            <span class="label">Role /</span>
            <span class="value">Lead Architect</span>
          </div>
          <div class="tags">
            {entry.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </div>

      {entry.data.image && (
        <div class="featured-image-container reveal" style="transition-delay: 0.2s;">
          <Image 
            src={entry.data.image} 
            alt={entry.data.title} 
            width={1600} 
            height={900} 
            class="featured-image"
          />
        </div>
      )}
    </header>

    <div class="project-grid container">
      <aside class="sidebar reveal" style="transition-delay: 0.3s;">
        <div class="sticky-content">
          <p class="summary">{entry.data.description}</p>
        </div>
      </aside>

      <article class="project-content reveal" style="transition-delay: 0.4s;">
        <Content />
        
        <footer class="project-navigation">
          <div class="nav-label">Next Project</div>
          <a href={`/projects/${nextEntry.id}`} class="next-link" aria-label={`View project details for: ${nextEntry.data.title}`}>
            <span class="next-title">{nextEntry.data.title}</span>
            <span class="next-arrow">→</span>
          </a>
        </footer>
      </article>
    </div>
  </main>
</Layout>

<style>
  .project-page {
    padding-bottom: 15vh;
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 10vh 5vw 5vh 5vw;
  }

  .back-link {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 4rem;
  }

  .back-link:hover .arrow {
    transform: translateX(-5px);
  }

  .arrow {
    transition: transform 0.3s ease;
  }

  .project-title {
    font-size: clamp(2rem, 10vw, 10rem);
    line-height: 0.85;
    margin-bottom: 4rem;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .project-meta {
    display: flex;
    gap: 4rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-item .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .meta-item .value {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .tag {
    border: 1px solid var(--border);
    padding: 0.3rem 0.8rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .featured-image-container {
    width: 100%;
    height: 70vh;
    overflow: hidden;
    margin-bottom: 8rem;
    background: var(--accent-soft);
  }

  .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
    transition: filter 0.5s ease, transform 0.8s ease;
  }

  .featured-image-container:hover .featured-image {
    filter: grayscale(0) contrast(1);
    transform: scale(1.02);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 8rem;
  }

  .sidebar .summary {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }

  .sticky-content {
    position: sticky;
    top: 5rem;
  }

  .project-content {
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 800px;
  }

  .project-content :global(h2) {
    font-size: 3rem;
    margin: 4rem 0 2rem 0;
    color: var(--accent);
  }

  .project-content :global(p) {
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .project-navigation {
    margin-top: 10rem;
    border-top: 2px solid var(--text);
    padding-top: 4rem;
  }

  .nav-label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 1rem;
    letter-spacing: 0.2em;
  }

  .next-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .next-title {
    font-size: clamp(2rem, 8vw, 6rem);
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
  }

  .next-arrow {
    font-size: clamp(2rem, 8vw, 6rem);
    transition: transform 0.3s ease;
  }

  .next-link:hover .next-arrow {
    transform: translateX(20px);
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 12vh 1.5rem 4vh 1.5rem;
    }
    .back-link {
      margin-bottom: 2rem;
    }
    .project-meta {
      gap: 2rem;
      padding-top: 2rem;
    }
    .featured-image-container {
      height: 40vh;
      margin-bottom: 4rem;
    }
    .container {
      padding: 0 1.5rem;
    }
    .sidebar .summary {
      font-size: 1.25rem;
    }
    .project-content {
      font-size: 1.1rem;
    }
    .project-content :global(h2) {
      font-size: 2rem;
      margin: 3rem 0 1.5rem 0;
    }
    .project-navigation {
      margin-top: 6rem;
      padding-top: 3rem;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const projectContent = document.querySelector('.project-content');
    if (projectContent) {
      const links = projectContent.querySelectorAll('a');
      links.forEach(link => {
        // Solo links que van a otros dominios
        if (link.hostname !== window.location.hostname && link.href.startsWith('http')) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
        }
      });
    }
  });
</script>
